# Generate .env.local with: uv run python scripts/init_local.py
POSTGRES_PASSWORD=replace-with-random-hex
REDIS_PASSWORD=replace-with-random-hex
ENGINE_DATABASE_URL=postgresql://engine:replace-with-random-hex@localhost:55432/engine
ENGINE_REDIS_URL=redis://:replace-with-random-hex@localhost:56379/0
ENGINE_JWT_SECRET=replace-with-at-least-32-random-characters
ENGINE_IDENTITY_ENABLED=false
ENGINE_SYMBOLS=BTCUSDT,ETHUSDT,BNBUSDT,SOLUSDT,XRPUSDT
ENGINE_ALLOWED_ORIGINS=http://localhost:5173
